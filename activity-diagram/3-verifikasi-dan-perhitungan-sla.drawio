<mxfile host="Electron" version="24.2.5" type="device">
  <diagram id="modul3" name="Verifikasi dan Perhitungan SLA">
    <mxGraphModel dx="900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1300" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
